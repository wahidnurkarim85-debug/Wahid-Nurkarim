rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Analytics Events: Anyone can create (tracking), but authenticated staff can read/delete
    match /analyticsEvents/{document} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Delivery Notification Logs:
    // Log entries for notifications sent to customers (Anggota & Basic) and tracked by Admin/Kurir
    match /deliveryNotificationLogs/{document} {
      allow read, write: if true;
    }

    // Customer Orders & Couriers Delivery Workflow:
    // Allow order placement by customers, status & proof photo updates by couriers/staff
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer Inbox: Messages and dispatch status notifications
    match /inbox/{messageId} {
      allow read, write: if true;
    }

    // Shipping Configuration & Vouchers:
    // Public read for delivery rates & GPS origin calculation
    match /shippingConfig/{document} {
      allow read, write: if true;
    }

    // Default match for other collections in Kopdes app
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
